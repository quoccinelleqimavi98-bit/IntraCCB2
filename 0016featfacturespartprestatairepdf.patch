         <div class="table">
           <p>{{ qteLabel(presta) }}</p>
           <p class="textoverflow">{{ nameLabel(presta) }}</p>
@@ -204,6 +213,12 @@
                 {{ fr() ? 'Déjà versé' : 'Already Paid' }} : {{ money(values().acompte) }}€
               </p>
             }
+            @if (providerTotal() > 0) {
+              <p class="tinytext">
+                {{ fr() ? 'Paiement prestataires' : 'Provider payment' }} :
+                {{ money(providerTotal()) }}€
