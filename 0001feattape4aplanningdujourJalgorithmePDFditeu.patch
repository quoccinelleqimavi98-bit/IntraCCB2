+  {
+    prenom: 'Cloé',
+    nom: 'CHAUDRON',
+    tel: '+33 6 68 64 44 02',
+    mail: 'cloe.chaudron@outlook.com',
+    arrivee: '',
+    retouches: '',
+    disponibilite: '',
+  },
+  {
+    prenom: 'Celma',
+    nom: 'SAHIDET',
+    tel: '+33 6 80 84 42 52',
+    mail: 'sahidetcelma@gmail.com',
+    arrivee: '',
+    retouches: '',
+    disponibilite: '',
+  },
+];
+
+/** En-têtes des 8 colonnes d'horaire du tableau (fr / en), dans l'ordre. */
