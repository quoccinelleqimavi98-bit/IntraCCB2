+++ b/src/app/features/documents/document-pdf.html
@@ -50,6 +50,15 @@
       <div class="fullligne"></div>
 
       @for (presta of orderedLines(); track $index) {
+        @if (providerLines().length && $index === providerStart()) {
+          <div class="provider-sep">
+            {{
+              fr()
+                ? 'Prestations assurées par un(e) prestataire de renfort — facturées et réglées directement auprès de lui/d’elle (non comprises dans mon total) :'
