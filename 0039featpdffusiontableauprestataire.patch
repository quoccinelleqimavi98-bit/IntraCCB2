-              <p>{{ fr() ? 'Prix Unitaire' : 'Unit Price' }}</p>
-              <p>{{ fr() ? 'Reduction' : 'Discount' }}</p>
-              <p>Total</p>
-            </div>
-            <div class="fullligne"></div>
