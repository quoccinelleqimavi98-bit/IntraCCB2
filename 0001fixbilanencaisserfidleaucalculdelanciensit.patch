-    for (const j of data) total += this.mineThisDay(j) - this.alreadyPaidThisDay(j, false);
+    for (const j of data) total += this.mineThisDay(j) - this.alreadyPaidThisDay(j, true);
     return Math.trunc(total);
   }
 
