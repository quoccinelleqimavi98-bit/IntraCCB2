     const index = this.prestas.indexOf(presta);
-    if (this.isAvenant) {
+    if (this.isDevis) {
       const base = Number(presta.qte);
       if (presta.qte !== '?' && base >= 2) presta.qte = base - 1;
       const copy: Presta = { ...presta, renfortQte: undefined, renfort: true, qte: 1 };
